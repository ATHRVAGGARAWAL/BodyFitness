{
  "name": "@bodyfitness/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@bodyfitness/contracts": "workspace:*",
    "@bodyfitness/core": "workspace:*",
    "@clerk/backend": "3.16.8",
    "@fastify/cors": "11.2.0",
    "@fastify/rate-limit": "10.3.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "drizzle-kit": "0.31.8",
    "tsx": "4.20.6",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
