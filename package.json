{
  "name": "bodyfitness",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:api": "pnpm --filter @bodyfitness/api dev",
    "dev:mobile": "pnpm --filter @bodyfitness/mobile start",
    "build": "next build --webpack",
    "build:api": "pnpm --filter @bodyfitness/api build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --filter @bodyfitness/contracts typecheck && pnpm --filter @bodyfitness/core typecheck && pnpm --filter @bodyfitness/api typecheck && pnpm --filter @bodyfitness/mobile typecheck",
    "test": "vitest run && pnpm --filter @bodyfitness/core test && pnpm --filter @bodyfitness/api test && pnpm --filter @bodyfitness/mobile test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bodyfitness/contracts": "workspace:*",
    "@bodyfitness/core": "workspace:*",
    "@clerk/nextjs": "7.7.8",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@serwist/next": "9.5.12",
    "framer-motion": "13.1.0",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.32.0",
    "next": "16.3.1",
    "openai": "7.5.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "serwist": "9.5.12",
    "vaul": "1.1.2",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
