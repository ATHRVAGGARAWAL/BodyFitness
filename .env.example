# ── AI (Azure AI Foundry, Responses API) ─────────────────────────────────────
# Mirrors the operator's Codex setup. Any OpenAI-compatible host works: set AI_BASE_URL.
AI_API_KEY=                                  # falls back to AZURE_OPENAI_API_KEY, then OPENAI_API_KEY
AZURE_AI_RESOURCE=satvikxs-8248-resource     # → https://<resource>.services.ai.azure.com/openai/v1
# AI_BASE_URL=https://api.openai.com/v1      # override the resolved base URL entirely
AI_MODEL=gpt-5.6-sol
AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
AI_SERVICE_TIER=priority                     # priority | default | flex | auto  ("fast" also accepted)
AI_EFFORT_FAST=low                           # voice parsing
AI_EFFORT_ANALYSIS=medium                    # meal analysis, plan configuration
AI_EFFORT_COACH=high                         # weekly coaching review
AI_TIMEOUT_MS=55000

# ── Accounts (Clerk) + saved data (Postgres) ─────────────────────────────────
# Both are optional; without them the app runs device-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=            # pk_test_… / pk_live_… from dashboard.clerk.com
CLERK_SECRET_KEY=                             # sk_test_… / sk_live_…
# Any Postgres URL (Vercel Marketplace → Neon/Supabase, or Railway). One table, created on first use.
# Local dev: podman run -d --name bodyfitness-pg -e POSTGRES_PASSWORD=bodyfitness \
#   -e POSTGRES_USER=bodyfitness -e POSTGRES_DB=bodyfitness -p 5433:5432 postgres:16-alpine
DATABASE_URL=postgres://bodyfitness:bodyfitness@localhost:5433/bodyfitness
# DATABASE_POOL_MAX=5

# ── Web → cloud sync API (optional) ──────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Railway API service (apps/api) ───────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bodyfitness
WEB_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
PORT=4000
